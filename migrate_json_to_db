import os
import json
import logging
from app.database import get_db, release_db, init_db
from psycopg2.extras import RealDictCursor

logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
logger = logging.getLogger(__name__)

USER_PROFILES_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data", "user_profiles")

def migrate_student_profiles():
    if not os.path.exists(USER_PROFILES_DIR):
        logger.error(f"Directory not found: {USER_PROFILES_DIR}")
        return

    # Ensure tables exist in Supabase
    init_db()
    
    json_files = [f for f in os.listdir(USER_PROFILES_DIR) if f.endswith(".json")]
    logger.info(f"Found {len(json_files)} student JSON profiles to process.")

    imported_users = 0
    imported_attempts = 0
    imported_saved = 0
    imported_feedbacks = 0
    imported_time = 0

    conn = get_db()
    cursor = conn.cursor(cursor_factory=RealDictCursor)

    for filename in json_files:
        filepath = os.path.join(USER_PROFILES_DIR, filename)
        try:
            with open(filepath, "r", encoding="utf-8") as f:
                data = json.load(f)

            reg = data.get("registration_info", {})
            if not reg or "user_id" not in reg:
                logger.warning(f"Skipping {filename}: Missing registration_info or user_id.")
                continue

            user_id = reg["user_id"]

            # 1. Insert / Upsert User Record
            cursor.execute('''
                INSERT INTO users (
                    user_id, student_id, full_name, username, phone_number, 
                    target_exam, dob, age, gender, country, state, pin, 
                    security_question, security_answer, referred_by, referral_count, 
                    bonus_quota, paid_question_balance, vip_pass_expiry, last_profile_edit, 
                    last_active, last_activity_epoch, is_banned, is_verified, created_at
                ) VALUES (
                    %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s
                ) ON CONFLICT (user_id) DO UPDATE SET
                    student_id = EXCLUDED.student_id,
                    full_name = EXCLUDED.full_name,
                    username = EXCLUDED.username,
                    phone_number = EXCLUDED.phone_number,
                    target_exam = EXCLUDED.target_exam,
                    dob = EXCLUDED.dob,
                    age = EXCLUDED.age,
                    gender = EXCLUDED.gender,
                    country = EXCLUDED.country,
                    state = EXCLUDED.state,
                    pin = EXCLUDED.pin,
                    security_question = EXCLUDED.security_question,
                    security_answer = EXCLUDED.security_answer,
                    paid_question_balance = EXCLUDED.paid_question_balance,
                    vip_pass_expiry = EXCLUDED.vip_pass_expiry,
                    last_active = EXCLUDED.last_active,
                    is_verified = 1
            ''', (
                user_id,
                reg.get("student_id"),
                reg.get("full_name"),
                reg.get("username"),
                reg.get("phone_number"),
                reg.get("target_exam"),
                reg.get("dob"),
                reg.get("age"),
                reg.get("gender"),
                reg.get("country", "India"),
                reg.get("state", "N/A"),
                reg.get("pin"),
                reg.get("security_question"),
                reg.get("security_answer"),
                reg.get("referred_by"),
                reg.get("referral_count", 0),
                reg.get("bonus_quota", 0),
                reg.get("paid_question_balance", 0),
                reg.get("vip_pass_expiry"),
                reg.get("last_profile_edit"),
                reg.get("last_active"),
                reg.get("last_activity_epoch", 0),
                reg.get("is_banned", 0),
                reg.get("is_verified", 1),
                reg.get("created_at")
            ))
            imported_users += 1

            # 2. Insert Quiz Attempts
            attempts = data.get("full_quiz_history", [])
            for att in attempts:
                details_json = json.dumps(att.get("question_details", [])) if att.get("question_details") else att.get("details_json")
                cursor.execute('''
                    INSERT INTO quiz_attempts (
                        user_id, quiz_id, questions_attempted, total_questions, 
                        correct_answers, wrong_answers, skipped_count, score, 
                        time_taken, attempt_timestamp, attempt_date, details_json
                    ) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
                ''', (
                    user_id,
                    att.get("quiz_id", "computer_awareness_mock"),
                    att.get("questions_attempted", 0),
                    att.get("total_questions", 0),
                    att.get("correct_answers", 0),
                    att.get("wrong_answers", 0),
                    att.get("skipped_count", 0),
                    att.get("score", 0.0),
                    att.get("time_taken", 0),
                    att.get("attempt_timestamp"),
                    att.get("attempt_date"),
                    details_json
                ))
                imported_attempts += 1

            # 3. Insert Bookmarked / Saved Questions
            saved_ledger = data.get("saved_questions_ledger", {}).get("saved_questions", [])
            for sq in saved_ledger:
                opts = json.dumps(sq.get("options", [])) if sq.get("options") else sq.get("options_json")
                cursor.execute('''
                    INSERT INTO saved_questions (
                        user_id, question_text, options_json, correct_option, explanation, saved_at
                    ) VALUES (%s, %s, %s, %s, %s, %s)
                ''', (
                    user_id,
                    sq.get("question_text"),
                    opts,
                    sq.get("correct_option", 0),
                    sq.get("explanation"),
                    sq.get("saved_at")
                ))
                imported_saved += 1

            # 4. Insert Reviews / Feedbacks
            feedbacks = data.get("student_reviews_given", [])
            for fb in feedbacks:
                cursor.execute('''
                    INSERT INTO student_feedback (
                        user_id, full_name, feedback_text, submitted_at
                    ) VALUES (%s, %s, %s, %s)
                ''', (
                    user_id,
                    fb.get("full_name"),
                    fb.get("feedback_text"),
                    fb.get("submitted_at")
                ))
                imported_feedbacks += 1

            # 5. Insert Activity Time Log
            daily_breakdown = data.get("bot_engagement_metrics", {}).get("daily_spent_time_breakdown", {})
            for date_str, time_str in daily_breakdown.items():
                # Extract integer seconds from text (e.g. "295 seconds (4.92 mins)")
                sec = 0
                try:
                    sec = int(time_str.split(" ")[0])
                except Exception:
                    pass

                cursor.execute('''
                    INSERT INTO user_activity_time (user_id, date_str, seconds_spent)
                    VALUES (%s, %s, %s)
                    ON CONFLICT (user_id, date_str) DO UPDATE SET
                        seconds_spent = EXCLUDED.seconds_spent
                ''', (user_id, date_str, sec))
                imported_time += 1

        except Exception as e:
            logger.error(f"Error processing {filename}: {e}")

    conn.commit()
    cursor.close()
    release_db(conn)

    logger.info("🎉 **DATA MIGRATION TO SUPABASE COMPLETE!** 🎉")
    logger.info(f"• Users Imported / Updated: {imported_users}")
    logger.info(f"• Quiz Attempts Imported: {imported_attempts}")
    logger.info(f"• Bookmarks Imported: {imported_saved}")
    logger.info(f"• Feedbacks Imported: {imported_feedbacks}")
    logger.info(f"• Activity Logs Imported: {imported_time}")

if __name__ == "__main__":
    migrate_student_profiles()